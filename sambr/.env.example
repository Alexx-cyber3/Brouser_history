# TraceFusion Environment Configuration
SECRET_KEY=tracefusion-dev-secret-key-change-in-production-2026
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Storage Directories
DATABASE_URL=sqlite:///instance/tracefusion.db
EVIDENCE_WORKSPACE=evidence
CASES_WORKSPACE=cases
REPORTS_WORKSPACE=reports
LOGS_WORKSPACE=logs

# Security & Limits
MAX_CONTENT_LENGTH=104857600  # 100 MB max upload
TIMEZONE=UTC
DEFAULT_REPORT_FORMAT=pdf
